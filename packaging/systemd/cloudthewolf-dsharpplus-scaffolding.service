[Unit]
Description=CloudTheWolf DSharpPlus Scaffolding Worker
Documentation=https://github.com/CloudTheWolf/CloudTheWolf.DSharpPlus.Scaffolding
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=cloudthewolf-bot
Group=cloudthewolf-bot
WorkingDirectory=/opt/cloudthewolf-dsharpplus-scaffolding
ExecStart=/opt/cloudthewolf-dsharpplus-scaffolding/CloudTheWolf.DSharpPlus.Scaffolding.Worker
Environment=WORKER_CONFIG_DIR=/etc/cloudthewolf-dsharpplus-scaffolding
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/cloudthewolf-dsharpplus-scaffolding

[Install]
WantedBy=multi-user.target
