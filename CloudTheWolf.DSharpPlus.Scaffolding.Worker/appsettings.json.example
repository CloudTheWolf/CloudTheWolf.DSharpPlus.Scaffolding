{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft": "Warning",
            "Microsoft.Hosting.Lifetime": "Information"
        }
    },
    "ShardMode": false,
    "UseZombieCure": true,
    "Plugins": {
        "hotReload": true,
        "reloadDelayMilliseconds": 1500
    },
    "Discord": {
        "token": "{{DISCORD_TOKEN}}",
        "prefix": "a!",
        "enableDms": true,
        "enableMentionPrefix": false,
        "dmHelp": false,
        "enableDefaultHelp": true,
        "priviligedIntents": {
            "guildMembers": false,
            "guildPresences": false,
            "messageContents": true
        },
        "debugGuildId": 0
    },
    "Database": {
        "type": "mysql",
        "mysql": {
            "server": "",
            "port": 3306,
            "userid": "",
            "password": "",
            "database": ""
        },
        "sqlsrv": {
            "server": "",
            "port": 1433,
            "userid": "",
            "password": "",
            "database": ""
        },
        "pgsql": {
            "server": "",
            "port": 5432,
            "userid": "",
            "password": "",
            "database": ""
        },
        "surreal": {
            "server": "http://127.0.0.1:8000",
            "userid": "",
            "password": "",
            "namespace": "",
            "database": ""
        },
        "sqlite": {
            "datasource": "/sqlite/database.db",
            "mode": 1,
            "password": ""
        },
        "supabase": {
            "connectionString": "Host=db.PROJECT.supabase.co;Port=5432;Username=postgres;Password=;Database=postgres;SSL Mode=Require"
        },
        "firebase": {
            "projectId": "",
            "databaseId": "",
            "detectEmulator": false
        }
    },
    "sql": {
        "host": "localhost",
        "user": "mySqlUser",
        "pass": "MySqlPass",
        "name": "MyDatabaseName"
    }
}
